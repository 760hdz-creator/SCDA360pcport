+// SCDA: XE_LAUNCH_DATA=<file> supplies launch data when none was set (boot straight into a map).
+static void ScdaInjectLaunchData(std::vector<uint8_t>& launch_data) {
+  static bool done = false;
+  if (done || !launch_data.empty()) {
+    return;
+  }
+  done = true;
+  if (const char* path = std::getenv("XE_LAUNCH_DATA")) {
+    if (FILE* f = std::fopen(path, "rb")) {
+      std::vector<uint8_t> data(MAX_LAUNCH_DATA_SIZE);
+      data.resize(std::fread(data.data(), 1, data.size(), f));
+      std::fclose(f);
+      launch_data = std::move(data);
+      XELOGI("SCDA: launch data {} bytes from {}", launch_data.size(), path);
+    }
+  }
+}
